# Copy to .env. Used by docker compose, the pipeline loader and the web app.
POSTGRES_PASSWORD=collectioneer
POSTGRES_PORT=5433
DATABASE_URL=postgres://collectioneer:collectioneer@127.0.0.1:5433/collectioneer

# Accounts (Better Auth). Secret: any long random string, e.g. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=CHANGE_ME
BETTER_AUTH_URL=http://localhost:3010
# Google sign-in (console.cloud.google.com > Credentials > OAuth client, Web application).
# Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google. Empty = the Google button is hidden.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare R2 for copy photos (R2 > Manage API tokens, Object Read & Write on the bucket).
# Empty = photos are stored on local disk under web/.data/uploads (development only).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public URL of the bucket (custom domain or r2.dev), no trailing slash
R2_PUBLIC_URL=

# Public contact address shown on /contact and in the legal pages. Empty = "coming soon".
NUXT_PUBLIC_CONTACT_EMAIL=
# Who runs the service (name or company, country), shown in the terms and privacy policy.
NUXT_PUBLIC_OPERATOR=
