{
  "name": "collectioneer-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --port 3010 --dotenv ../.env",
    "build": "nuxt build",
    "preview": "nuxt preview --port 3010 --dotenv ../.env",
    "typecheck": "nuxt typecheck",
    "db:types": "node --env-file=../.env node_modules/kanel/bin/kanel",
    "postinstall": "nuxt prepare",
    "auth:schema": "node --env-file=../.env node_modules/tsx/dist/cli.mjs scripts/auth-schema.ts",
    "grant-role": "node --env-file=../.env node_modules/tsx/dist/cli.mjs scripts/grant-role.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1150.0",
    "better-auth": "1.7.14",
    "nuxt": "4.6.2",
    "pg": "8.23.1",
    "postgres": "3.4.9",
    "sharp": "0.35.5",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "kanel": "4.0.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vue-tsc": "3.3.14"
  }
}
